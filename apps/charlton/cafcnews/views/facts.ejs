<%- include('partials/header', { pageTitle: 'Fun Facts' }) %>

<div class="page-head">
  <div class="page-head__inner">
    <div class="eyebrow"><%= totalFacts %> facts and counting</div>
    <h1>Fun Facts</h1>
    <p class="lede">120 years of Charlton Athletic, boiled down to the stories worth knowing — a goalkeeper found after tragedy, a future US President handing over the cup, and the time fans started their own political party.</p>
  </div>
</div>

<section>
  <div class="wrap">
    <div class="facts-toolbar">
      <button id="shuffleFact" class="btn btn--primary" type="button">🎲 Show me a random fact</button>
      <div id="randomFactCard" class="fact-card fact-card--featured" hidden></div>
    </div>

    <% data.categories.forEach(cat => { %>
      <h2 class="section-title"><%= cat.name %></h2>
      <div class="facts-grid" style="margin-bottom:36px;">
        <% cat.facts.forEach(f => { %>
          <div class="fact-card reveal">
            <span class="fact-card__year"><%= f.year %></span>
            <h3 class="fact-card__title"><%= f.title %></h3>
            <p class="fact-card__body"><%= f.body %></p>
            <% if (f.source) { %><a class="fact-card__source" href="<%= f.source.url %>" target="_blank" rel="noopener noreferrer">Source: <%= f.source.label %> ↗</a><% } %>
          </div>
        <% }) %>
      </div>
    <% }) %>
  </div>
</section>

<script>
  (function() {
    const facts = <%- JSON.stringify(data.categories.flatMap(c => c.facts.map(f => ({...f, category: c.name})))) %>;
    const btn = document.getElementById('shuffleFact');
    const card = document.getElementById('randomFactCard');
    btn.addEventListener('click', () => {
      const f = facts[Math.floor(Math.random() * facts.length)];
      card.hidden = false;
      card.replaceChildren();
      const year = document.createElement('span');
      year.className = 'fact-card__year';
      year.textContent = `${f.year} · ${f.category}`;
      const title = document.createElement('h3');
      title.className = 'fact-card__title';
      title.textContent = f.title;
      const body = document.createElement('p');
      body.className = 'fact-card__body';
      body.textContent = f.body;
      card.append(year, title, body);
      if (f.source) {
        const source = document.createElement('a');
        source.className = 'fact-card__source';
        source.href = f.source.url;
        source.target = '_blank';
        source.rel = 'noopener noreferrer';
        source.textContent = `Source: ${f.source.label} ↗`;
        card.append(source);
      }
      card.classList.remove('is-pulsing');
      void card.offsetWidth;
      card.classList.add('is-pulsing');
    });
  })();
</script>

<%- include('partials/footer') %>
